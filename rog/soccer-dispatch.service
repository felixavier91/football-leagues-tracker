[Unit]
Description=Trigger the football tracker's GitHub Actions bots when matches are on (soccer-highlights.org)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -I %h/Work/football-leagues-tracker/rog_dispatch.py
